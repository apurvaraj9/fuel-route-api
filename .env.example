# Copy this file to .env for local development. Never commit .env.

# Local development: DEBUG on, any secret key works.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: free OpenRouteService API key (https://openrouteservice.org/dev/#/signup).
# Leave empty to use the public OSRM routing server, which needs no key.
ORS_API_KEY=

# Optional tuning (defaults shown).
# ROUTE_CORRIDOR_MILES=10
# HIGHWAY_SNAP_MILES=20
# FUEL_STOP_PENALTY_USD=15
# MIN_PURCHASE_GALLONS=10
# ROUTE_ALTERNATIVES=3
# ROUTE_RATE_LIMIT=30/min
# HTTP_CONNECT_TIMEOUT_SECONDS=5
# HTTP_READ_TIMEOUT_SECONDS=20
# HTTP_USER_AGENT=fuel-route-api/2.0 (+https://github.com/your-name/fuel-route-api)

# Optional: create an admin user automatically in build.sh / Docker (leave unset otherwise).
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=choose-a-strong-password
