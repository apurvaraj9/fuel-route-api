{
  "info": {
    "name": "Fuel Route Planner API v2",
    "description": "Demo requests for the fuel route planner API. baseUrl points to the live deployment; change it to http://127.0.0.1:8000 for a local server. Interactive docs: {{baseUrl}}/api/docs/. The free Render instance sleeps after 15 minutes idle, so the first request can take about a minute.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://fuel-route-api-h6na.onrender.com"
    }
  ],
  "item": [
    {
      "name": "1. Long route: New York -> Los Angeles",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/route/?start=New York, NY&finish=Los Angeles, CA",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            }
          ]
        }
      }
    },
    {
      "name": "2. POST JSON: Chicago -> Dallas (compares 2 route options)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Dallas, TX\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/route/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        }
      }
    },
    {
      "name": "3. Options: quarter tank, 50-mile reserve",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Dallas, TX\",\n  \"start_fuel_percent\": 25,\n  \"reserve_miles\": 50\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/route/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        }
      }
    },
    {
      "name": "4. Fastest route instead of cheapest",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/route/?start=Chicago, IL&finish=Dallas, TX&route_preference=fastest",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Chicago, IL"
            },
            {
              "key": "finish",
              "value": "Dallas, TX"
            },
            {
              "key": "route_preference",
              "value": "fastest"
            }
          ]
        }
      }
    },
    {
      "name": "5. Short route: New York -> Philadelphia (no stop needed)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/route/?start=New York, NY&finish=Philadelphia, PA",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Philadelphia, PA"
            }
          ]
        }
      }
    },
    {
      "name": "6. Coordinates input: Houston -> Denver",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/route/?start=29.7604,-95.3698&finish=39.7392,-104.9903",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "29.7604,-95.3698"
            },
            {
              "key": "finish",
              "value": "39.7392,-104.9903"
            }
          ]
        }
      }
    },
    {
      "name": "7. Error: location outside the USA",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/route/?start=Toronto, ON&finish=Dallas, TX",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Toronto, ON"
            },
            {
              "key": "finish",
              "value": "Dallas, TX"
            }
          ]
        }
      }
    },
    {
      "name": "8. Error: invalid option",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/route/?start=Dallas, TX&finish=Denver, CO&start_fuel_percent=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Dallas, TX"
            },
            {
              "key": "finish",
              "value": "Denver, CO"
            },
            {
              "key": "start_fuel_percent",
              "value": "5"
            }
          ]
        }
      }
    },
    {
      "name": "9. Health and fuel data",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/health/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health",
            ""
          ],
          "query": []
        }
      }
    }
  ]
}
